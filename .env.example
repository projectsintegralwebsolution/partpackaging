# Parth Packaging Environment Configuration
PORT=3000
NODE_ENV=production
SITE_URL=https://parthpackaging.com

# SMTP Mail Server Settings (Optional - fallback logs to logs/email-outbox.log)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM="Parth Packaging" <noreply@parthpackaging.com>
