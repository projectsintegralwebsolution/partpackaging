<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "LocalBusiness"],
      "@id": "<%= site.domain %>/#organization",
      "name": "<%= site.name %>",
      "legalName": "<%= site.legalName %>",
      "url": "<%= site.domain %>",
      "logo": {
        "@type": "ImageObject",
        "url": "<%= site.domain %>/images/parth-packaging-logo.png",
        "width": "484",
        "height": "100"
      },
      "image": "<%= site.domain %>/images/hero-facility.jpg",
      "description": "<%= site.description %>",
      "email": "<%= site.email %>",
      "telephone": "<%= site.phoneClean %>",
      "priceRange": "₹₹",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "<%= site.address.street %>",
        "addressLocality": "<%= site.address.city %>",
        "addressRegion": "<%= site.address.state %>",
        "postalCode": "<%= site.address.pincode %>",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 19.8055,
        "longitude": 72.7483
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
        "opens": "08:30",
        "closes": "19:30"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "84",
        "bestRating": "5",
        "worstRating": "1"
      },
      "areaServed": [
        { "@type": "AdministrativeArea", "name": "Maharashtra" },
        { "@type": "AdministrativeArea", "name": "Gujarat" },
        { "@type": "Country", "name": "India" }
      ],
      "sameAs": ["<%= site.social.linkedin %>", "<%= site.social.twitter %>"]
    },
    {
      "@type": "Service",
      "@id": "<%= site.domain %>/#service-carboys",
      "name": "Industrial Carboys & Drums Reconditioning",
      "serviceType": "Packaging Reconditioning & Chemical Decontamination",
      "provider": { "@id": "<%= site.domain %>/#organization" },
      "areaServed": "India",
      "description": "Certified industrial decontamination, automated rotary chemical washing, hot-air drying, and 100% pneumatic pressure decay testing of HDPE carboys and 210L drums."
    },
    {
      "@type": "Product",
      "@id": "<%= site.domain %>/#product-tighthead-210",
      "name": "210 Litre Reconditioned Tight Head HDPE Carboy Drum",
      "image": "<%= site.domain %>/images/product-tight-head.jpg",
      "description": "UN 1H1/Y1.9 certified 210L high-molecular weight HDPE reconditioned drum with 2 inch bung closures and 100% pneumatic leak test certification.",
      "brand": { "@type": "Brand", "name": "Parth Packaging" },
      "offers": {
        "@type": "Offer",
        "availability": "https://schema.org/InStock",
        "priceCurrency": "INR",
        "price": "950"
      }
    },
    {
      "@type": "Product",
      "@id": "<%= site.domain %>/#product-ibc-1000",
      "name": "1000 Litre Reconditioned Composite IBC Container Tote",
      "image": "<%= site.domain %>/images/product-ibc-tote.jpg",
      "description": "Composite intermediate bulk container with clean decontaminated HDPE bottle, tubular steel grid cage, integrated 2-inch ball valve, and pallet base.",
      "brand": { "@type": "Brand", "name": "Parth Packaging" },
      "offers": {
        "@type": "Offer",
        "availability": "https://schema.org/InStock",
        "priceCurrency": "INR",
        "price": "4200"
      }
    },
    {
      "@type": "WebSite",
      "@id": "<%= site.domain %>/#website",
      "url": "<%= site.domain %>",
      "name": "<%= site.name %>",
      "description": "<%= site.description %>",
      "publisher": { "@id": "<%= site.domain %>/#organization" },
      "inLanguage": "en-IN"
    }<% if (typeof faqs !== 'undefined' && faqs && faqs.length > 0) { %>,
    {
      "@type": "FAQPage",
      "@id": "<%= site.domain + currentPath %>/#faq",
      "mainEntity": [
        <% faqs.forEach((faq, index) => { %>
        {
          "@type": "Question",
          "name": "<%= faq.question.replace(/"/g, '\\"') %>",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "<%= faq.answer.replace(/"/g, '\\"').replace(/\n/g, ' ') %>"
          }
        }<%= index < faqs.length - 1 ? ',' : '' %>
        <% }) %>
      ]
    }<% } %>
  ]
}
</script>
