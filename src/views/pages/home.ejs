          <!-- Pillar 3: 100% ETP Closed Loop -->
          <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-left: 4px solid #F59E0B; border-radius: 8px; padding: 16px 18px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
              <h4 style="color: #FFFFFF; font-size: 1rem; margin: 0; font-weight: 700;">3. 100% ETP Recirculation Loop (Zero Liquid Discharge)</h4>
              <span style="background: rgba(245, 158, 11, 0.2); color: #FCD34D; font-size: 0.7rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">MPCB Mandated</span>
            </div>
