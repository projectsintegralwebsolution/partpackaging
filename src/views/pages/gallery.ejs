<%- include('../partials/layout-top') %>

<section class="section section-dark">
  <div class="container text-center">
    <span class="section-eyebrow">Visual Tour & Facility Infrastructure</span>
    <h1 style="color: #FFFFFF; margin-bottom: 16px;">Facility, Operations & Product Gallery</h1>
    <p class="section-subtitle" style="max-width: 740px; margin: 0 auto;">
      A transparent visual journey through our automated wash bays, precision pneumatic leak testing stations, product portfolio, and Pan-India dispatch logistics.
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="gallery-grid">
      <!-- 1. Central Plant -->
      <div class="industrial-img-card">
        <div class="industrial-img-wrap">
          <span class="industrial-img-badge">Facility Hub</span>
          <img src="/images/hero-facility.jpg" alt="Automated Drum Reconditioning Lines & High-Bay Facility" width="600" height="400" loading="lazy">
        </div>
        <div class="industrial-img-body">
          <h3 class="industrial-img-title">Automated Reconditioning Facility</h3>
          <p class="industrial-img-desc">Modern industrial manufacturing plant equipped with continuous automated conveyor lines, staging racks, and industrial LED high-bay illumination.</p>
          <div class="industrial-img-tags">
            <span class="industrial-img-tag">Automated Lines</span>
            <span class="industrial-img-tag">Capacity: 25k/Mo</span>
            <span class="industrial-img-tag">Boisar / Tarapur</span>
          </div>
        </div>
      </div>

      <!-- 2. Chemical Washing -->
      <div class="industrial-img-card">
        <div class="industrial-img-wrap">
          <span class="industrial-img-badge">Stage 2 & 3: Washing</span>
          <img src="/images/process-washing.jpg" alt="Automated 360-degree Rotary Chemical Wash Booth" width="600" height="400" loading="lazy">
        </div>
        <div class="industrial-img-body">
          <h3 class="industrial-img-title">Robotic High-Pressure Wash Station</h3>
          <p class="industrial-img-desc">Enclosed stainless-steel wash bays deploying 360° dual-axis rotary spray heads with heated neutralizing chemistry and steam decontamination.</p>
          <div class="industrial-img-tags">
            <span class="industrial-img-tag">80 Bar Jetting</span>
            <span class="industrial-img-tag">Alkaline / Acid Neutralization</span>
            <span class="industrial-img-tag">Steam Sanitation</span>
          </div>
        </div>
      </div>

      <!-- 3. Wall Gauge Testing -->
      <div class="industrial-img-card">
        <div class="industrial-img-wrap">
          <span class="industrial-img-badge">Stage 1: Inspection</span>
          <img src="/images/process-inspection.jpg" alt="Ultrasonic Wall Thickness & Optical Testing Lab" width="600" height="400" loading="lazy">
        </div>
        <div class="industrial-img-body">
          <h3 class="industrial-img-title">Ultrasonic Wall Gauge & QC Lab</h3>
          <p class="industrial-img-desc">Precision ultrasonic non-destructive testing verifies polymer wall thickness (≥2.5mm) and internal boroscope detects hidden interior stress cracks.</p>
          <div class="industrial-img-tags">
            <span class="industrial-img-tag">Ultrasonic NDT</span>
            <span class="industrial-img-tag">Boroscope Optical</span>
            <span class="industrial-img-tag">Residue Titration</span>
          </div>
        </div>
      </div>

      <!-- 4. Pneumatic Leak Testing -->
      <div class="industrial-img-card">
        <div class="industrial-img-wrap">
          <span class="industrial-img-badge">Stage 5: 100% Testing</span>
          <img src="/images/process-leaktest.jpg" alt="Automated Pneumatic Digital Leak Decay Test Bench" width="600" height="400" loading="lazy">
        </div>
        <div class="industrial-img-body">
          <h3 class="industrial-img-title">Digital Pneumatic Leak Testing Station</h3>
          <p class="industrial-img-desc">Every container is clamped and pressurized to 30 kPa with differential micro-transducer monitoring to guarantee absolute hermetic sealing.</p>
          <div class="industrial-img-tags">
            <span class="industrial-img-tag">30 kPa Pressure Decay</span>
            <span class="industrial-img-tag">100% Individual Test</span>
            <span class="industrial-img-tag">Zero Defect Target</span>
          </div>
        </div>
      </div>

      <!-- 5. 210L Tight Head -->
      <div class="industrial-img-card">
        <div class="industrial-img-wrap">
          <span class="industrial-img-badge">Product: Tight Head</span>
          <img src="/images/product-tight-head.jpg" alt="210L Reconditioned Tight-Head HDPE Carboy Drum" width="600" height="400" loading="lazy">
        </div>
        <div class="industrial-img-body">
          <h3 class="industrial-img-title">210L Tight Head HDPE Carboy</h3>
          <p class="industrial-img-desc">Seamless blow-molded HMW-HDPE container certified for hazardous liquids, industrial acids, solvents, and specialty chemical distribution.</p>
          <div class="industrial-img-tags">
            <span class="industrial-img-tag">UN 1H1/Y1.9/250</span>
            <span class="industrial-img-tag">2" Buttress Bungs</span>
            <span class="industrial-img-tag">Liquid Hazardous</span>
          </div>
        </div>
      </div>

      <!-- 6. 210L Open Top -->
      <div class="industrial-img-card">
        <div class="industrial-img-wrap">
          <span class="industrial-img-badge">Product: Open Top</span>
          <img src="/images/product-open-top.jpg" alt="210L Reconditioned Open Top Drum with Locking Ring" width="600" height="400" loading="lazy">
        </div>
        <div class="industrial-img-body">
          <h3 class="industrial-img-title">210L Open Top Drum with Clamp Ring</h3>
          <p class="industrial-img-desc">Heavy-duty plastic drum featuring removable top lid and galvanized steel lever-lock clamp band, ideal for solids, pigments, and viscous pastes.</p>
          <div class="industrial-img-tags">
            <span class="industrial-img-tag">UN 1H2/Y1.6/150</span>
            <span class="industrial-img-tag">Lever-Action Clamp</span>
            <span class="industrial-img-tag">Solid / Powder</span>
          </div>
        </div>
      </div>

      <!-- 7. 1000L IBC Tote -->
      <div class="industrial-img-card">
        <div class="industrial-img-wrap">
          <span class="industrial-img-badge">Product: Bulk IBC</span>
          <img src="/images/product-ibc-tote.jpg" alt="1000L Reconditioned Composite IBC Container" width="600" height="400" loading="lazy">
        </div>
        <div class="industrial-img-body">
          <h3 class="industrial-img-title">1000L Composite IBC Container</h3>
          <p class="industrial-img-desc">Decontaminated HDPE inner container with galvanized tubular steel protective grid, integrated bottom discharge valve, and reinforced pallet.</p>
          <div class="industrial-img-tags">
            <span class="industrial-img-tag">1000 Litre Volume</span>
            <span class="industrial-img-tag">Integrated 2" Valve</span>
            <span class="industrial-img-tag">UN 31HA1 Approved</span>
          </div>
        </div>
      </div>

      <!-- 8. Closures & Accessories -->
      <div class="industrial-img-card">
        <div class="industrial-img-wrap">
          <span class="industrial-img-badge">Hardware & Seals</span>
          <img src="/images/product-accessories.jpg" alt="Industrial Carboy Closures Bungs and Viton Seals" width="600" height="400" loading="lazy">
        </div>
        <div class="industrial-img-body">
          <h3 class="industrial-img-title">Certified Closures, Seals & Bungs</h3>
          <p class="industrial-img-desc">Virgin polymer bung plugs, microporous venting breathers, heavy Viton/EPDM gaskets, and torque-calibrated tightening tools.</p>
          <div class="industrial-img-tags">
            <span class="industrial-img-tag">DIN 51 / DIN 61</span>
            <span class="industrial-img-tag">EPDM / Viton Seals</span>
            <span class="industrial-img-tag">Torque Calibrated</span>
          </div>
        </div>
      </div>

      <!-- 9. Warehouse Logistics -->
      <div class="industrial-img-card">
        <div class="industrial-img-wrap">
          <span class="industrial-img-badge">Logistics Hub</span>
          <img src="/images/facility-warehouse.jpg" alt="High-Bay Warehouse and Fleet Loading Staging" width="600" height="400" loading="lazy">
        </div>
        <div class="industrial-img-body">
          <h3 class="industrial-img-title">High-Bay Warehouse & Dispatch Staging</h3>
          <p class="industrial-img-desc">Heavy-duty pallet racking holding over 10,000 ready-to-dispatch units with dedicated loading docks and commercial transport fleet.</p>
          <div class="industrial-img-tags">
            <span class="industrial-img-tag">High-Bay Racking</span>
            <span class="industrial-img-tag">Fleet Logistics</span>
            <span class="industrial-img-tag">Pan-India Transit</span>
          </div>
        </div>
      </div>

      <!-- 10. ESG & Sustainability -->
      <div class="industrial-img-card">
        <div class="industrial-img-wrap">
          <span class="industrial-img-badge">Circular Economy</span>
          <img src="/images/esg-sustainability.jpg" alt="Circular Economy and 85% Carbon Footprint Reduction" width="600" height="400" loading="lazy">
        </div>
        <div class="industrial-img-body">
          <h3 class="industrial-img-title">Circular Economy & ESG Impact</h3>
          <p class="industrial-img-desc">Every reconditioned carboy prevents up to 10.5 kg of virgin fossil polymer extraction and reduces supply chain greenhouse emissions by 85%.</p>
          <div class="industrial-img-tags">
            <span class="industrial-img-tag">85% Carbon Reduction</span>
            <span class="industrial-img-tag">Closed Loop Reuse</span>
            <span class="industrial-img-tag">ESG Compliance</span>
          </div>
        </div>
      </div>

      <!-- 11. Before Reconditioning -->
      <div class="industrial-img-card">
        <div class="industrial-img-wrap">
          <span class="industrial-img-badge" style="color: #F87171; border-color: rgba(248,113,113,0.4);">Inward Raw Condition</span>
          <img src="/images/drum-soiled-before.jpg" alt="Soiled Used Drum Upon Arrival" width="600" height="400" loading="lazy">
        </div>
        <div class="industrial-img-body">
          <h3 class="industrial-img-title">Raw Used Container at Receiving</h3>
          <p class="industrial-img-desc">Chemical residues, weathered surface, scuffs, and expired hazmat labeling prior to our automated decontamination cycle.</p>
          <div class="industrial-img-tags">
            <span class="industrial-img-tag">Used Empty</span>
            <span class="industrial-img-tag">Pre-Cleaning State</span>
          </div>
        </div>
      </div>

      <!-- 12. After Reconditioning -->
      <div class="industrial-img-card">
        <div class="industrial-img-wrap">
          <span class="industrial-img-badge" style="color: #34D399; border-color: rgba(52,211,153,0.4);">Finished Certified State</span>
          <img src="/images/drum-clean-after.jpg" alt="Reconditioned Drum Decontaminated and Polished" width="600" height="400" loading="lazy">
        </div>
        <div class="industrial-img-body">
          <h3 class="industrial-img-title">Certified Reconditioned Container</h3>
          <p class="industrial-img-desc">Fully stripped, chemically washed, pressure tested, fitted with new closures, and compliant with UN certification standards.</p>
          <div class="industrial-img-tags">
            <span class="industrial-img-tag">100% Tested</span>
            <span class="industrial-img-tag">Ready for Dispatch</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/cta-banner') %>

